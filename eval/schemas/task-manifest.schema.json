{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "selectionRule",
    "corpusProvenanceSha256",
    "seeds",
    "runtime",
    "v01Baseline",
    "judge",
    "thresholds",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "const": "agentic-compact-v0.2"
    },
    "selectionRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "corpusProvenanceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "seeds": {
      "type": "object",
      "required": [
        "armOrderSeed",
        "bootstrapSeed",
        "judgeSamplingSeed"
      ],
      "properties": {
        "armOrderSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "bootstrapSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "judgeSamplingSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "codexVersion",
        "codexBinarySha256",
        "model",
        "reasoningEffort",
        "serviceTier",
        "sandboxMode",
        "approvalPolicy",
        "runtimeConfigSha256",
        "environmentSha256",
        "dependencyCacheSha256",
        "targetContextWindow",
        "fixedFallbackLimit",
        "noForcedLimit"
      ],
      "properties": {
        "codexVersion": {
          "const": "0.146.0"
        },
        "codexBinarySha256": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "const": "gpt-5.6-luna"
        },
        "reasoningEffort": {
          "const": "high"
        },
        "serviceTier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sandboxMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "approvalPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "runtimeConfigSha256": {
          "$ref": "#/$defs/sha256"
        },
        "environmentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependencyCacheSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetContextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "fixedFallbackLimit": {
          "type": "integer",
          "const": 49152
        },
        "noForcedLimit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "v01Baseline": {
      "type": "object",
      "required": [
        "releaseTag",
        "sourceCommit",
        "binarySha256",
        "pluginSha256",
        "surfaceSha256",
        "capabilityRecordSha256"
      ],
      "properties": {
        "releaseTag": {
          "const": "v0.1.0"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "binarySha256": {
          "$ref": "#/$defs/sha256"
        },
        "pluginSha256": {
          "$ref": "#/$defs/sha256"
        },
        "surfaceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "capabilityRecordSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "judge": {
      "type": "object",
      "required": [
        "backendId",
        "modelRevision",
        "settingsSha256",
        "judgeConfigSha256",
        "calibrationExamplesSha256",
        "promptSha256",
        "doubleReviewRate",
        "minimumAgreement"
      ],
      "properties": {
        "backendId": {
          "$ref": "#/$defs/opaqueId"
        },
        "modelRevision": {
          "$ref": "#/$defs/opaqueId"
        },
        "settingsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "judgeConfigSha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibrationExamplesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "promptSha256": {
          "type": "object",
          "required": [
            "trigger",
            "checkpoint",
            "continuation"
          ],
          "properties": {
            "trigger": {
              "$ref": "#/$defs/sha256"
            },
            "checkpoint": {
              "$ref": "#/$defs/sha256"
            },
            "continuation": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "doubleReviewRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumAgreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "bootstrapSamples",
        "maximumSolvedTaskDeficit",
        "minimumObservedQualityDifference",
        "minimumQualityLowerBound",
        "minimumCompactSubsetTasks",
        "maximumCompactSubsetMedian",
        "maximumCompactSubsetUpperBound",
        "maximumBlendedTokenRatio",
        "maximumMedianWallRatio",
        "minimumPolicyTasks",
        "minimumPolicyRequests",
        "maximumHarmfulTriggerRate",
        "maximumRepeatedSettledPhaseRate",
        "maximumCriticalOmissionRate",
        "minimumActionableNextActionRate",
        "minimumHostEvidenceRecall"
      ],
      "properties": {
        "bootstrapSamples": {
          "type": "integer",
          "minimum": 1
        },
        "maximumSolvedTaskDeficit": {
          "type": "integer",
          "minimum": 0
        },
        "minimumObservedQualityDifference": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "minimumQualityLowerBound": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "minimumCompactSubsetTasks": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCompactSubsetMedian": {
          "type": "number",
          "minimum": 0
        },
        "maximumCompactSubsetUpperBound": {
          "type": "number",
          "minimum": 0
        },
        "maximumBlendedTokenRatio": {
          "type": "number",
          "minimum": 0
        },
        "maximumMedianWallRatio": {
          "type": "number",
          "minimum": 0
        },
        "minimumPolicyTasks": {
          "type": "integer",
          "minimum": 1
        },
        "minimumPolicyRequests": {
          "type": "integer",
          "minimum": 1
        },
        "maximumHarmfulTriggerRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumRepeatedSettledPhaseRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumCriticalOmissionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumActionableNextActionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumHostEvidenceRecall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "benchmark",
          "role",
          "baseCommit",
          "fallbackExposed",
          "semanticBundleEligible",
          "diagnosticSubset",
          "selectionEvidence",
          "taskConfigSha256"
        ],
        "properties": {
          "taskId": {
            "$ref": "#/$defs/opaqueId"
          },
          "benchmark": {
            "enum": [
              "swe-bench-verified",
              "long-range-controlled"
            ]
          },
          "role": {
            "enum": [
              "dev",
              "held-out"
            ]
          },
          "baseCommit": {
            "$ref": "#/$defs/commit"
          },
          "fallbackExposed": {
            "type": "boolean"
          },
          "semanticBundleEligible": {
            "type": "boolean"
          },
          "diagnosticSubset": {
            "type": "boolean"
          },
          "selectionEvidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "native-fallback",
                "active-context-pressure",
                "semantic-bundle",
                "public-long-horizon"
              ]
            }
          },
          "taskConfigSha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
